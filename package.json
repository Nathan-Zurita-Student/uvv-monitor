{
  "name": "uvv-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Assistente acadêmico pessoal para monitoramento seguro e somente leitura da UVV.",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "portal:inspect": "tsx src/cli/inspect-portal.ts",
    "portal:inspect:authenticated": "tsx src/cli/inspect-authenticated-portal.ts",
    "portal:collect": "tsx src/cli/collect-portal.ts",
    "portal:check": "tsx src/cli/check-portal-login.ts",
    "telegram:get-chat-id": "tsx src/cli/telegram-get-chat-id.ts",
    "telegram:test": "tsx src/cli/telegram-test.ts",
    "google:authorize": "tsx src/cli/google-authorize.ts",
    "google:test": "tsx src/cli/google-test.ts",
    "sheets:setup": "tsx src/cli/sheets-setup.ts",
    "sheets:test": "tsx src/cli/sheets-test.ts",
    "config:check": "tsx src/cli/config-check.ts",
    "ai:test": "tsx src/cli/ai-test.ts",
    "start": "tsx src/cli/run.ts"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.2",
    "googleapis": "^182.0.0",
    "open": "^11.0.4",
    "pdfjs-dist": "^5.4.296",
    "pino": "^9.9.5",
    "playwright": "^1.55.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.5.2",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^5.0.3"
  }
}
