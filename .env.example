# Portal UVV (obrigatórios para portal:check)
UVV_USERNAME=
UVV_PASSWORD=

# Execução segura: mantenha true até validar todo o fluxo
DRY_RUN=true
TZ=America/Sao_Paulo

# Telegram (fases posteriores)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Ative somente depois de publicar o Google Apps Script e registrar o webhook
TELEGRAM_WEBHOOK_ENABLED=false
TELEGRAM_ACTIONS_WEB_APP_URL=

# Google OAuth (fases posteriores)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEET_ID=
GOOGLE_CALENDAR_ID=primary

# URL privada gerada em Ambiente Virtual > Calendário > Exportar calendário
MOODLE_CALENDAR_URL=

# IA opcional. O monitor continua funcionando com AI_ENABLED=false.
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_MAX_CALLS_PER_RUN=20
AI_MAX_INPUT_CHARS=20000

# Ajustes opcionais
LOG_LEVEL=info
PORTAL_TIMEOUT_MS=30000
DIAGNOSTICS_DIR=artifacts/diagnostics
RUN_SLOT=12:00
