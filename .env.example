# Portal UVV (obrigatórios para portal:check)
UVV_USERNAME=
UVV_PASSWORD=

# Execução segura: mantenha true até validar todo o fluxo
DRY_RUN=true
TZ=America/Sao_Paulo

# Telegram (fases posteriores)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google OAuth (fases posteriores)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEET_ID=

# Ajustes opcionais
LOG_LEVEL=info
PORTAL_TIMEOUT_MS=30000
DIAGNOSTICS_DIR=artifacts/diagnostics
